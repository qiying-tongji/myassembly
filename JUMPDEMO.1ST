				===== 
				; TEST 1: SHORT JMP 
				; =============================================
				===== 
				 
 000D  EB 08			    JMP SHORT SHORT_TARGET 
				 
				    ; This code should be skipped 
 000F  B4 09			    MOV AH, 09H 
 0011  8D 16 0081 R		    LEA DX, errorMsg 
 0015  CD 21			    INT 21H 
				 
				 
 0017				SHORT_TARGET: 
				 
 0017  B4 09			    MOV AH, 09H 
 0019  8D 16 0015 R		    LEA DX, shortMsg 
 001D  CD 21			    INT 21H 
				 
				 
				; =============================================
				===== 
				; TEST 2: NEAR JMP 
				; =============================================
				===== 
				 
 001F  EB 09 90			    JMP NEAR PTR NEAR_TARGET 
				 
				    ; This code should be skipped 
 0022  B4 09			    MOV AH, 09H 
 0024  8D 16 0081 R		    LEA DX, errorMsg 
 0028  CD 21			    INT 21H 
				 
				 
 002A				NEAR_TARGET: 
				 
 002A  B4 09			    MOV AH, 09H 
 002C  8D 16 0025 R		    LEA DX, nearMsg 
 0030  CD 21			    INT 21H 
				 
				 
				; =============================================
				===== 
				; TEST 3: CONDITIONAL SHORT JMP 
				; =============================================
				===== 
				 
 0032  B8 0001			    MOV AX, 1 
				 
 0035  3D 0001			    CMP AX, 1 
				 
 0038  74 08			    JE SHORT COND_TARGET 
				 
				    ; This code should be skipped 
Microsoft (R) Macro Assembler Version 5.00                  11/13/26 19:56:21
                                                             Page     1-4


 003A  B4 09			    MOV AH, 09H 
 003C  8D 16 0081 R		    LEA DX, errorMsg 
 0040  CD 21			    INT 21H 
				 
				 
 0042				COND_TARGET: 
				 
 0042  B4 09			    MOV AH, 09H 
 0044  8D 16 0034 R		    LEA DX, condMsg 
 0048  CD 21			    INT 21H 
				 
				 
				; =============================================
				===== 
				; TEST 4: 
				; Conditional jump to a far destination 
				; 
				; 8086 conditional jumps only support SHORT. 
				; We use the opposite condition to skip FAR JMP
				. 
				; =============================================
				===== 
				 
 004A  B8 0000			    MOV AX, 0 
				 
 004D  3D 0001			    CMP AX, 1 
				 
 0050  75 05			    JNE SHORT FAR_COND_SKIP 
				 
				    ; If AX equals 1, jump to another segment 
 0052  EA 0000 ---- R		    JMP FAR PTR FAR_TARGET 
				 
				 
 0057				FAR_COND_SKIP: 
				 
				    ; AX is not equal to 1 
 0057  B4 09			    MOV AH, 09H 
 0059  8D 16 0050 R		    LEA DX, skipMsg 
 005D  CD 21			    INT 21H 
				 
				 
				    ; Now make the condition true 
 005F  B8 0001			    MOV AX, 1 
				 
 0062  3D 0001			    CMP AX, 1 
				 
 0065  75 05			    JNE SHORT FAR_COND_END 
				 
 0067  EA 0000 ---- R		    JMP FAR PTR FAR_TARGET 
				 
				 
 006C				FAR_COND_END: 
				 
 006C  B4 09			    MOV AH, 09H 
Microsoft (R) Macro Assembler Version 5.00                  11/13/26 19:56:21
                                                             Page     1-5


 006E  8D 16 0081 R		    LEA DX, errorMsg 
 0072  CD 21			    INT 21H 
				 
				 
				    ; Exit if unexpected path is reached 
 0074  B8 4C00			    MOV AX, 4C00H 
 0077  CD 21			    INT 21H 
				 
				 
 0079				MAINCODE ENDS 
				 
				 
				; =============================================
				===== 
				; CALENDAR CODE SEGMENT 
				; =============================================
				===== 
				 
 0000				CALCODE SEGMENT PARA PUBLIC 'CODE' 
				 
				ASSUME CS:CALCODE, DS:DATA 
				 
				 
				; =============================================
				===== 
				; TEST 5: FAR JMP TARGET 
				; =============================================
				===== 
				 
 0000				FAR_TARGET: 
				 
 0000  B4 09			    MOV AH, 09H 
				 
 0002  8D 16 0073 R		    LEA DX, farMsg 
				 
 0006  CD 21			    INT 21H 
				 
				 
				    ; Terminate program 
 0008  B8 4C00			    MOV AX, 4C00H 
 000B  CD 21			    INT 21H 
				 
				 
 000D				CALCODE ENDS 
				 
				 
				END START 
