				; =============================================
				===== 
				; MAIN CODE SEGMENT 
				; =============================================
				===== 
				 
 0000				MAINCODE SEGMENT PARA PUBLIC 'CODE' 
				 
				ASSUME CS:MAINCODE, DS:DATA, SS:STACKSEG 
				 
				 
 0000				START: 
				 
				    ; Initialize data segment 
 0000  B8 ---- R		    MOV AX, DATA 
 0003  8E D8			    MOV DS, AX 
				 
				 
				; =============================================
				===== 
				; Display title 
				; =============================================
				===== 
				 
 0005  B4 09			    MOV AH, 09H 
 0007  8D 16 0000 R		    LEA DX, titleMsg 
 000B  CD 21			    INT 21H 
				 
				 
				; =============================================
